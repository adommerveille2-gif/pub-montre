# ---------------------------------------------------------------------------
# Copier ce fichier vers `.env` (à la racine) et `packages/db/.env` puis compléter.
# Ne jamais committer les vraies valeurs.
# ---------------------------------------------------------------------------

# PostgreSQL (pgvector requis dès la phase 2)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pubmontre_dev?schema=public"

# Auth.js — générer avec : openssl rand -base64 32
AUTH_SECRET=""
# URL publique de l'application (requise en production)
AUTH_URL="http://localhost:3000"

# Envoi des liens de connexion par e-mail.
# EMAIL_DRIVER=console affiche le lien dans les journaux du serveur (par défaut hors production).
# EMAIL_DRIVER=smtp exige SMTP_URL (par défaut en production).
EMAIL_DRIVER="console"
SMTP_URL=""
EMAIL_FROM="Tuteur médical <no-reply@example.com>"

# Stockage privé des cours importés (phase 2). Dossier local hors du dossier public.
STORAGE_DIR=""

# Fournisseurs IA (phases 2 et suivantes, non utilisés en phase 0)
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
