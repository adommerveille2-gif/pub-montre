# ---------------------------------------------------------------------------
# Copier ce fichier vers `.env` (à la racine) et `packages/db/.env` puis compléter.
# Ne jamais committer les vraies valeurs.
# ---------------------------------------------------------------------------

# PostgreSQL (pgvector requis dès la phase 2)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pubmontre_dev?schema=public"

# Auth.js — générer avec : openssl rand -base64 32
AUTH_SECRET=""
# URL publique de l'application (requise en production)
AUTH_URL="http://localhost:3000"

# Envoi des liens de connexion par e-mail.
# EMAIL_DRIVER=console affiche le lien dans les journaux du serveur (par défaut hors production).
# EMAIL_DRIVER=smtp exige SMTP_URL (par défaut en production).
EMAIL_DRIVER="console"
SMTP_URL=""
EMAIL_FROM="Tuteur médical <no-reply@example.com>"

# Stockage privé des fichiers.
# Développement : disque local (STORAGE_DIR optionnel). Production : STORAGE_DRIVER=s3 obligatoire.
STORAGE_DRIVER="local"
STORAGE_DIR=""
# S3_BUCKET=""
# S3_ENDPOINT=""          (Cloudflare R2 : https://<compte>.r2.cloudflarestorage.com)
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Tuteur IA (Anthropic). Sans clé, le tuteur est désactivé et le signale.
ANTHROPIC_API_KEY=""
# TUTOR_MODEL="claude-sonnet-5-5"

# Embeddings (OpenAI) pour la recherche sémantique dans les cours.
# Sans clé, la recherche reste plein texte.
OPENAI_API_KEY=""
# EMBEDDING_MODEL="text-embedding-3-small"  (1536 dimensions, obligatoire avec la base)
